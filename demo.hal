fizzbuzz :: (number: integer) {
  loop i: 0 {
    print_string(
      if i % 3 == 0 and i % 5 == 0 {
        "fizzbuzz\n"
      } else if i % 3 == 0{
        "fizz\n"
      } else if i % 5 == 0 {
        "buzz\n"
      } else {
        ""
      }
    );
    if i == number {
      break;
    }
    i + 1
  }
}

main :: () {
  fizzbuzz(15);
}
