// Integer arithmetic
1 + 2;
1 - 2;
1 * 2;
1 / 2;
1 % 2;

// Real arithmetic
1.0 +. 2.0;
1.0 -. 2.0;
1.0 *. 2.0;
1.0 /. 2.0;

// Boolean logical
true and false;
true or false;
true xor false;

// Unit comparison
() == ();
() != ();
() <= ();
() >= ();
() < ();
() > ();

// Integer comparison
1 == 2;
1 != 2;
1 <= 2;
1 >= 2;
1 < 2;
1 > 2;

// Real comparison
1.0 == 2.0;
1.0 != 2.0;
1.0 <= 2.0;
1.0 >= 2.0;
1.0 < 2.0;
1.0 > 2.0;

// Boolean comparison
true == false;
true != false;
true <= false;
true >= false;
true < false;
true > false;

// Glyph comparison
'a' == 'b';
'a' != 'b';
'a' <= 'b';
'a' >= 'b';
'a' < 'b';
'a' > 'b'
